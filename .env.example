# Copy this file to .env for local development. Never commit real secrets.
RIDEFLOW_ENVIRONMENT=local
RIDEFLOW_DEBUG=false
RIDEFLOW_DATABASE_URL=postgresql+asyncpg://rideflow:rideflow@db:5432/rideflow
RIDEFLOW_CORS_ORIGINS=["http://localhost:5173"]
RIDEFLOW_JWT_SECRET=replace-with-at-least-32-random-characters
RIDEFLOW_ACCESS_TOKEN_TTL_MINUTES=15
RIDEFLOW_REFRESH_TOKEN_TTL_DAYS=30

# Used by Docker Compose to initialize PostgreSQL.
POSTGRES_DB=rideflow
POSTGRES_USER=rideflow
POSTGRES_PASSWORD=rideflow

# The browser reaches the API through the host port.
VITE_API_BASE_URL=http://localhost:8000/api/v1
